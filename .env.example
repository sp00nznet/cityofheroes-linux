# Folder that holds the Ouroboros v2i210 install (Server/, Setup/, Client/).
COH_DIR=/path/to/Ouroboros-v2i210
# MSSQL sa password: 8+ chars with upper, lower, digit and symbol, or MSSQL won't start.
SA_PASSWORD=
# Address clients use to reach the shard: 127.0.0.1 for this machine, the host's LAN IP for LAN play.
COH_IP=127.0.0.1
# MSSQL memory cap in MB (it takes most of the RAM otherwise).
MSSQL_MEMORY_LIMIT_MB=2048
# 1 to run the GUI ServerMonitor (costs ~a quarter core idle under Wine).
SERVERMONITOR=0
# Admin panel login (user admin), http://localhost:8080. 8+ chars; the panel won't start without it.
PANEL_PASSWORD=
